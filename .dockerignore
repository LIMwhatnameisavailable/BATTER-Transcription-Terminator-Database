# Keep image builds focused on application code.  Large scientific assets and
# local checkout state must never become Docker build context by accident.
.git
.git/**
.worktrees
.worktrees/**
.github
.github/**
.dockerignore
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.coverage
**/node_modules
**/.next
**/dist
data
data/**
raw
raw/**
site
site/**
browser
browser/**
prototype
prototype/**
docs
docs/**
tests
tests/**
scripts
scripts/**
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai
*.cram
*.crai
*.bigWig
*.bw
*.wig
*.wig.gz
*.zip
*.tar
*.tar.gz
*.docx
