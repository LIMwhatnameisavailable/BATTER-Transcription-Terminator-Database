# Local-only Compose defaults.  Do not use these values for a deployed service.
POSTGRES_DB=bted
POSTGRES_USER=bted
POSTGRES_PASSWORD=change-me-before-sharing
POSTGRES_PORT=5432
BTED_API_PORT=8000
FRONTEND_PORT=3000

# The value is used both as the Next.js rewrite target at build time and by
# server-side rendering at runtime.  `backend` is the Compose service name.
BTED_API_ORIGIN=http://backend:8000
